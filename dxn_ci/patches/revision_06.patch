+			failure = "wheel %s suspension length escaped bounds value=%.4f allowed=[%.4f, %.4f]" % [wheel.name, wheel.suspension_length, minimum_length, maximum_length]
+			return
+		if not is_finite(wheel.normal_load) or not is_finite(wheel.suspension_force) or not is_finite(wheel.angular_velocity):
+			failure = "wheel %s produced non-finite dynamics" % wheel.name
+			return
+		if wheel.normal_load > app.vehicle.config.maximum_force_per_wheel * 1.02:
+			failure = "wheel %s exceeded maximum normal load" % wheel.name
+			return
+
+func _track_dynamic_metrics() -> void:
+	var grounded_count: int = _grounded_wheel_count()
+	minimum_grounded_wheels = min(minimum_grounded_wheels, grounded_count)
+	maximum_grounded_wheels = max(maximum_grounded_wheels, grounded_count)
+	throttle_reached_vehicle = throttle_reached_vehicle or app.vehicle.input_state.throttle > TEST_THROTTLE * 0.55
+	for wheel_value in app.vehicle.wheels:
+		var wheel: DXNWheelRuntime = wheel_value
+		maximum_suspension_force = max(maximum_suspension_force, wheel.suspension_force)
+		maximum_compression_ratio = max(maximum_compression_ratio, wheel.compression_ratio)
+		if wheel.index < 2:
+			peak_front_drive_torque = max(peak_front_drive_torque, abs(wheel.drive_torque))
+		else:
+			peak_rear_drive_torque = max(peak_rear_drive_torque, abs(wheel.drive_torque))
+		peak_steer_angle = max(peak_steer_angle, abs(wheel.steer_angle))
+
+func _grounded_wheel_count() -> int:
+	var grounded_count: int = 0
+	for wheel_value in app.vehicle.wheels:
+		var wheel: DXNWheelRuntime = wheel_value
+		if wheel.grounded:
+			grounded_count += 1
+	return grounded_count
+
+func _finish_success(final_speed_kmh: float) -> void:
+	var displacement: float = acceleration_end_position.distance_to(start_position)
+	print(
+		"DXN_RUNTIME_SMOKE_PASS displacement=", displacement,
+		" speed_before_brake=", speed_before_braking_kmh,
+		" final_speed=", final_speed_kmh,
+		" rear_torque_peak=", peak_rear_drive_torque,
+		" front_torque_peak=", peak_front_drive_torque,
+		" grounded_min=", minimum_grounded_wheels,
+		" suspension_force_peak=", maximum_suspension_force,
+		" compression_peak=", maximum_compression_ratio
+	)
+	_cleanup_and_quit(0)
+
+func _finish_failure(message: String) -> void:
+	push_error("DXN_RUNTIME_SMOKE_FAIL " + message)
+	_cleanup_and_quit(1)
+
+func _cleanup_and_quit(exit_code: int) -> void:
+	if app != null and is_instance_valid(app):
+		root.remove_child(app)
+		app.free()
+		app = null
+	quit(exit_code)
diff -ruN dxn_car_sandbox_v5/tests/vehicle_integration_tests.gd /mnt/data/dxn_car_sandbox_v5/tests/vehicle_integration_tests.gd
--- dxn_car_sandbox_v5/tests/vehicle_integration_tests.gd	1970-01-01 00:00:00.000000000 +0000
+++ dxn_car_sandbox_v5/tests/vehicle_integration_tests.gd	2026-07-29 19:51:40.818522007 +0000
@@ -0,0 +1,199 @@
+extends SceneTree
+
+enum Stage {
+	BOOT,
+	CURB_SETTLE,
+	CURB_APPROACH,
+	CURB_RECOVERY,
+	SUSPENSION_SETTLE,
+	SUSPENSION_RUN,
+	FINISH
+}
+
+const CURB_ZONE: String = "CURB & CONTACT"
+const SUSPENSION_ZONE: String = "SUSPENSION LAB"
+const TEST_TIMEOUT: float = 18.0
+
+var app: DXNApp
+var elapsed: float = 0.0
+var stage_elapsed: float = 0.0
+var stage: Stage = Stage.BOOT
+var failure: String = ""
+var curb_contact_seen: bool = false
+var curb_peak_impulse: float = 0.0
+var curb_peak_vertical_speed: float = 0.0
+var suspension_peak_compression: float = 0.0
+var suspension_peak_force: float = 0.0
+var suspension_contact_frames: int = 0
+var suspension_airborne_frames: int = 0
+var initial_suspension_position: Vector3 = Vector3.ZERO
+var final_suspension_position: Vector3 = Vector3.ZERO
+
+func _initialize() -> void:
+	var scene_resource: PackedScene = load("res://scenes/main.tscn")
+	if scene_resource == null:
+		_finish_failure("main scene failed to load")
+		return
+	var instance: Node = scene_resource.instantiate()
+	root.add_child(instance)
+	app = instance as DXNApp
+	if app == null:
+		_finish_failure("root is not DXNApp")
+
+func _process(delta: float) -> bool:
+	elapsed += delta
+	stage_elapsed += delta
+	if elapsed > TEST_TIMEOUT:
+		_finish_failure("integration test timeout at stage=" + Stage.keys()[stage])
+		return true
+	if app == null:
+		return false
+	_validate_finite_state()
+	if not failure.is_empty():
+		_finish_failure(failure)
+		return true
+
+	match stage:
+		Stage.BOOT:
+			if stage_elapsed >= 0.6:
+				if app.vehicle == null or app.test_ground == null or app.input_router == null:
+					_finish_failure("application dependencies missing")
+					return true
+				app._start_driving()
+				app.test_ground.reset_vehicle_to_zone(CURB_ZONE)
+				_set_controls(0.0, 0.0, 0.0)
+				_change_stage(Stage.CURB_SETTLE)
+		Stage.CURB_SETTLE:
+			if stage_elapsed >= 1.1:
+				if _grounded_count() < 3:
+					_finish_failure("curb-zone spawn did not settle on ground")
+					return true
+				_set_controls(0.0, 0.50, 0.0)
+				_change_stage(Stage.CURB_APPROACH)
+		Stage.CURB_APPROACH:
+			_track_curb_metrics()
+			if stage_elapsed >= 4.4:
+				_set_controls(0.0, 0.0, 0.72)
+				_change_stage(Stage.CURB_RECOVERY)
+		Stage.CURB_RECOVERY:
+			_track_curb_metrics()
+			if stage_elapsed >= 1.6:
+				if app.vehicle.telemetry.speed_kmh > 9.0:
+					_finish_failure("vehicle did not decelerate after curb approach")
+					return true
+				if curb_peak_impulse > app.vehicle.config.curb_impulse_limit * 1.02:
+					_finish_failure("curb impulse exceeded configured safety cap")
+					return true
+				if curb_peak_vertical_speed > 12.0:
+					_finish_failure("curb contact launched vehicle vertically peak=%.3f" % curb_peak_vertical_speed)
+					return true
+				app.test_ground.reset_vehicle_to_zone(SUSPENSION_ZONE)
+				_set_controls(0.0, 0.0, 0.0)
+				_change_stage(Stage.SUSPENSION_SETTLE)
+		Stage.SUSPENSION_SETTLE:
+			if stage_elapsed >= 1.1:
+				if _grounded_count() < 3:
+					_finish_failure("suspension-zone spawn did not settle")
+					return true
+				initial_suspension_position = app.vehicle.body_state.position
+				_set_controls(0.0, 0.44, 0.0)
+				_change_stage(Stage.SUSPENSION_RUN)
+		Stage.SUSPENSION_RUN:
+			_track_suspension_metrics()
+			if stage_elapsed >= 5.0:
+				final_suspension_position = app.vehicle.body_state.position
+				var travelled: float = final_suspension_position.distance_to(initial_suspension_position)
+				if travelled < 3.0:
+					_finish_failure("suspension course travel too short distance=%.3f" % travelled)
+					return true
+				if suspension_contact_frames < 25:
+					_finish_failure("too few grounded suspension samples")
+					return true
+				if suspension_peak_force < 750.0:
+					_finish_failure("suspension never generated meaningful force")
+					return true
+				if suspension_peak_force > app.vehicle.config.maximum_force_per_wheel * 1.02:
+					_finish_failure("suspension force exceeded wheel cap")
+					return true
+				if suspension_peak_compression > 1.02:
+					_finish_failure("suspension compression escaped normalized range")
+					return true
+				stage = Stage.FINISH
+				_finish_success(travelled)
+		Stage.FINISH:
+			return true
+	return false
+
+func _set_controls(steer_value: float, throttle_value: float, brake_value: float) -> void:
+	app.input_router.set_touch_steer(steer_value, true)
+	app.input_router.set_touch_throttle(throttle_value, true)
+	app.input_router.set_touch_brake(brake_value, true)
+
+func _track_curb_metrics() -> void:
+	curb_peak_vertical_speed = max(curb_peak_vertical_speed, abs(app.vehicle.body_state.linear_velocity.y))
+	for wheel_value in app.vehicle.wheels:
+		var wheel: DXNWheelRuntime = wheel_value
+		curb_contact_seen = curb_contact_seen or wheel.curb_contact
+		curb_peak_impulse = max(curb_peak_impulse, abs(wheel.curb_impulse))
+
+func _track_suspension_metrics() -> void:
+	var grounded_count: int = _grounded_count()
+	if grounded_count >= 2:
+		suspension_contact_frames += 1
+	else:
+		suspension_airborne_frames += 1
+	for wheel_value in app.vehicle.wheels:
+		var wheel: DXNWheelRuntime = wheel_value
+		suspension_peak_compression = max(suspension_peak_compression, wheel.compression_ratio)
+		suspension_peak_force = max(suspension_peak_force, wheel.suspension_force)
+
+func _validate_finite_state() -> void:
+	if app.vehicle == null:
+		return
+	var state: DXNRigidBodyState = app.vehicle.body_state
+	if not DXNMath.is_finite_vector3(state.position) or not DXNMath.is_finite_vector3(state.linear_velocity) or not DXNMath.is_finite_vector3(state.angular_velocity):
+		failure = "non-finite body state"
+		return
+	if not DXNMath.is_finite_quaternion(state.orientation):
+		failure = "non-finite body orientation"
+		return
+	for wheel_value in app.vehicle.wheels:
+		var wheel: DXNWheelRuntime = wheel_value
+		if not is_finite(wheel.suspension_length) or not is_finite(wheel.suspension_force) or not is_finite(wheel.angular_velocity):
+			failure = "non-finite wheel state " + wheel.name
+			return
+
+func _grounded_count() -> int:
+	var result: int = 0
+	for wheel_value in app.vehicle.wheels:
+		var wheel: DXNWheelRuntime = wheel_value
+		if wheel.grounded:
+			result += 1
+	return result
+
+func _change_stage(next_stage: Stage) -> void:
+	stage = next_stage
+	stage_elapsed = 0.0
+
+func _finish_success(suspension_distance: float) -> void:
+	print(
+		"DXN_VEHICLE_INTEGRATION_PASS curb_contact_seen=", curb_contact_seen,
+		" curb_impulse_peak=", curb_peak_impulse,
+		" curb_vertical_speed_peak=", curb_peak_vertical_speed,
+		" suspension_distance=", suspension_distance,
+		" suspension_force_peak=", suspension_peak_force,
+		" suspension_compression_peak=", suspension_peak_compression,
+		" suspension_airborne_frames=", suspension_airborne_frames
+	)
+	_cleanup_and_quit(0)
+
+func _finish_failure(message: String) -> void:
+	push_error("DXN_VEHICLE_INTEGRATION_FAIL " + message)
+	_cleanup_and_quit(1)
+
+func _cleanup_and_quit(exit_code: int) -> void:
+	if app != null and is_instance_valid(app):
+		root.remove_child(app)
+		app.free()
+		app = null
+	quit(exit_code)
