+func _monitor_runtime_state() -> void:
+	if app.vehicle == null:
+		return
+	var state: DXNRigidBodyState = app.vehicle.body_state
+	if not DXNMath.is_finite_vector3(state.position):
+		failure = "vehicle position became non-finite"
+		return
+	if not DXNMath.is_finite_vector3(state.linear_velocity):
+		failure = "vehicle linear velocity became non-finite"
+		return
+	if not DXNMath.is_finite_vector3(state.angular_velocity):
+		failure = "vehicle angular velocity became non-finite"
+		return
+	if not DXNMath.is_finite_quaternion(state.orientation):
+		failure = "vehicle orientation became non-finite"
+		return
+	if abs(state.orientation.length() - 1.0) > 0.01:
+		failure = "vehicle quaternion lost normalization"
+		return
