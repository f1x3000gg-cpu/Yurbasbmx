+func _minimum_upshift_speed_mps(gear: int, target_rpm: float) -> float:
+	var total_ratio: float = abs(ratio_for_gear(gear)) * max(config.final_drive_ratio, 0.001)
+	var radius: float = 0.5 * (config.rear_wheel_radius + config.front_wheel_radius)
+	var theoretical_speed: float = target_rpm * TAU / 60.0 * radius / max(total_ratio, 0.001)
+	return max(theoretical_speed * 0.43, 2.8 + float(max(gear - 1, 0)) * 1.8)
+
+func _minimum_hold_speed_mps(gear: int) -> float:
+	if gear <= 1:
+		return 0.0
+	var lower_total_ratio: float = abs(ratio_for_gear(gear - 1)) * max(config.final_drive_ratio, 0.001)
+	var radius: float = 0.5 * (config.rear_wheel_radius + config.front_wheel_radius)
+	var theoretical_speed: float = config.automatic_shift_down_rpm * TAU / 60.0 * radius / max(lower_total_ratio, 0.001)
+	return max(theoretical_speed * 0.52, 1.8 + float(gear - 2) * 1.35)
+
